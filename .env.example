# --- Django ---
# Clave secreta: genera una con `python -c "import secrets; print(secrets.token_urlsafe(60))"`
SECRET_KEY=cambiar-en-produccion
# Desarrollo: True. Producción: False
DEBUG=True
# Ej: localhost,127.0.0.1,midominio.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Obligatorio en producción (con esquema). Ej: https://midominio.com,https://www.midominio.com
# CSRF_TRUSTED_ORIGINS=https://midominio.com
# Desarrollo: sqlite:///db.sqlite3  Producción: postgres://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3
# Opcional: redis://user:pass@host:6379/0 (si no, usa memoria local)
# CACHE_URL=redis://localhost:6379/0

# --- Contacto (se muestran en la sección contacto) ---
CONTACT_EMAIL=contacto@tudominio.com
WHATSAPP_NUMBER=
# Ej: 5219511234567 (código de país + número, sin + ni espacios)

# --- Correo saliente (notificación de leads y enlace de acceso al panel) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# --- Anti-spam y pagos ---
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_SECONDS=60
# Nº de proxies de confianza delante de la app (0 = REMOTE_ADDR)
TRUSTED_PROXY_COUNT=0
# Tope del monto que un cliente puede registrar
PAYMENT_MAX_AMOUNT=100000
# Versión del aviso de privacidad aceptado en los formularios
PRIVACY_NOTICE_VERSION=2026-10

# --- Mercado Pago (opcional: sin MP_ACCESS_TOKEN, tarjeta y OXXO quedan ocultos) ---
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# --- Producción (solo con config.settings.prod) ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
