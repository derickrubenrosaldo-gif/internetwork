# --- Django ---
# Clave secreta: genera una con `python -c "import secrets; print(secrets.token_urlsafe(60))"`
SECRET_KEY=cambiar-en-produccion
# Desarrollo: True. Producción: False
DEBUG=True
# Ej: localhost,127.0.0.1,midominio.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Desarrollo: sqlite:///db.sqlite3  Producción: postgres://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3
# Opcional: redis://user:pass@host:6379/0 (si no, usa memoria local)
# CACHE_URL=redis://localhost:6379/0

# --- Contacto (se muestran en la sección contacto) ---
CONTACT_EMAIL=contacto@tudominio.com
WHATSAPP_NUMBER=
# Ej: 5219511234567 (código de país + número, sin + ni espacios)

# --- Correo saliente (notificación de leads) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# --- Anti-spam: máximo solicitudes por IP ---
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_SECONDS=60

# --- Producción (solo con config.settings.prod) ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
